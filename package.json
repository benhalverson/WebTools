{
  "name": "ardupilot-webtools-tests",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter @webtools/react-workflows... --filter @webtools/numerics --filter @webtools/dataflash build && node tooling/serve.ts dev",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck && pnpm --filter portal exec tsc -p ../../tooling/tsconfig.json",
    "lint": "pnpm -r --if-present lint && apps/portal/node_modules/.bin/oxlint --deny-warnings tooling",
    "test": "node --test tests/*.test.cjs && pnpm test:parameters && pnpm test:dataflash && pnpm --filter @webtools/mavlink test && pnpm --filter @webtools/numerics test && pnpm test:react-workflows && pnpm --filter @webtools/transfers test && pnpm test:routing && pnpm test:rotation-check && pnpm test:widgets && pnpm test:hardware-parameters && pnpm test:kinematic-tools && pnpm test:scurve-tool && pnpm test:pid-review && pnpm test:dfu-loader",
    "test:browser": "node tests/browser.cjs",
    "test:video": "node tests/video-browser.cjs",
    "test:portal": "node --test apps/portal/tests/*.test.cjs",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "preview": "node tooling/serve.ts preview",
    "test:parameters": "pnpm --filter @webtools/parameters test",
    "test:dataflash": "pnpm --filter @webtools/dataflash test",
    "test:dataflash:browser": "pnpm --filter @webtools/dataflash test:browser",
    "test:mavlink:browser": "pnpm --filter @webtools/mavlink test:browser",
    "test:numerics:browser": "pnpm --filter @webtools/numerics test:browser",
    "test:react-workflows": "pnpm --filter @webtools/parameters build && pnpm --filter @webtools/react-workflows test",
    "test:react-workflows:browser": "pnpm --filter @webtools/parameters build && pnpm --filter @webtools/react-workflows test:browser",
    "test:transfers:browser": "pnpm --filter @webtools/transfers test:browser",
    "test:routing": "node --test packages/routing/tests/*.test.ts tooling/*.test.ts",
    "test:rotation-check": "node --test apps/rotation-check/tests/*.test.*",
    "test:rotation-check:browser": "node --test apps/rotation-check/tests/browser.cjs",
    "test:parameters:browser": "pnpm --filter @webtools/parameters test:browser",
    "test:widgets": "pnpm --filter @webtools/widget-runtime test",
    "test:widgets:browser": "pnpm --filter @webtools/mavlink build && pnpm --filter @webtools/widget-runtime test:browser",
    "test:hardware-parameters": "node --test apps/hardware-report/tests/*.test.*",
    "test:hardware-parameters:browser": "node --test apps/hardware-report/tests/browser.cjs",
    "test:kinematic-tools": "node --experimental-vm-modules --test apps/kinematic-tools/tests/parity.test.mjs",
    "test:kinematic-tools:browser": "node --experimental-vm-modules --test apps/kinematic-tools/tests/browser.mjs",
    "test:scurve-tool": "node --test apps/scurve-tool/tests/*.test.ts",
    "test:scurve-tool:browser": "node --test apps/scurve-tool/tests/browser.cjs",
    "test:pid-review": "node --test apps/pid-review/tests/*.test.mjs",
    "test:pid-review:browser": "node --test apps/pid-review/tests/browser.mjs",
    "test:dfu-loader": "node --test apps/dfu-loader/tests/*.test.ts",
    "test:dfu-loader:browser": "node --test apps/dfu-loader/tests/browser.cjs"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "ws": "8.18.3",
    "@types/node": "26.6.4",
    "@webtools/routing": "workspace:*"
  }
}
