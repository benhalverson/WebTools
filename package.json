{
  "name": "ardupilot-webtools-tests",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter portal dev",
    "typecheck": "pnpm --filter @webtools/dataflash typecheck && pnpm --filter portal typecheck",
    "lint": "pnpm --filter @webtools/dataflash lint && pnpm --filter portal lint",
    "test": "node --test tests/*.test.cjs && pnpm test:dataflash",
    "test:browser": "node tests/browser.cjs",
    "test:video": "node tests/video-browser.cjs",
    "test:portal": "node --test apps/portal/tests/*.test.cjs",
    "build": "pnpm --filter @webtools/dataflash build && pnpm --filter portal build",
    "preview": "pnpm --filter portal preview",
    "test:dataflash": "pnpm --filter @webtools/dataflash test",
    "test:dataflash:browser": "pnpm --filter @webtools/dataflash test:browser"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "ws": "8.18.3"
  }
}
