{
  "name": "ardupilot-webtools-tests",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter portal dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "node --test tests/*.test.cjs && pnpm --filter @webtools/mavlink test && pnpm --filter @webtools/transfers test && pnpm --filter @webtools/parameters test",
    "test:browser": "node tests/browser.cjs",
    "test:video": "node tests/video-browser.cjs",
    "test:portal": "node --test apps/portal/tests/*.test.cjs",
    "build": "pnpm -r --if-present build",
    "preview": "pnpm --filter portal preview",
    "test:mavlink:browser": "pnpm --filter @webtools/mavlink test:browser",
    "test:transfers:browser": "pnpm --filter @webtools/transfers test:browser",
    "test:parameters": "pnpm --filter @webtools/parameters test"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "ws": "8.18.3"
  }
}
