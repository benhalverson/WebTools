{
  "name": "geofence-generator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @webtools/numerics build && pnpm --filter @webtools/react-workflows... build && vite --host 127.0.0.1",
    "typecheck": "pnpm --filter @webtools/numerics build && pnpm --filter @webtools/react-workflows... build && pnpm cf-typegen && tsc -b",
    "build": "pnpm typecheck && vite build",
    "lint": "biome lint --error-on-warnings .",
    "preview": "vite preview --host 127.0.0.1",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "test": "pnpm --filter @webtools/numerics build && node --test tests/*.test.ts",
    "test:browser": "pnpm --filter @webtools/numerics build && pnpm --filter @webtools/react-workflows... build && node --test tests/browser.cjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@webtools/react-workflows": "workspace:*",
    "@webtools/routing": "workspace:*",
    "@webtools/numerics": "workspace:*",
    "leaflet": "1.9.4",
    "leaflet-editable": "1.2.0",
    "@bagage/leaflet.restoreview": "1.0.1",
    "osmtogeojson": "3.0.0-beta.5",
    "@turf/turf": "6.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.62.5",
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "wrangler": "4.147.0",
    "@types/leaflet": "1.9.21",
    "@types/geojson": "7946.0.16",
    "@types/osmtogeojson": "2.2.34",
    "leaflet-control-geocoder": "3.3.1"
  }
}
