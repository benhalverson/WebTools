{
  "name": "@webtools/parameters",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint --error-on-warnings .",
    "test": "pnpm --filter @webtools/transfers build && pnpm build && tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "test:browser": "pnpm build && node tests/browser.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@webtools/transfers": "workspace:*"
  }
}
