{
  "name": "@webtools/numerics",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node tooling/build-vendor.mjs",
    "typecheck": "pnpm build && tsc -p tests/tsconfig.json",
    "lint": "oxlint --deny-warnings src tests tooling",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:browser": "pnpm build && node tests/browser.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "oxlint": "1.81.0",
    "vite": "8.3.0"
  }
}
