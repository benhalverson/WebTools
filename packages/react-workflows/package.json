{
  "name": "@webtools/react-workflows", "version": "0.0.0", "private": true, "type": "module",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.consumer.json",
    "lint": "oxlint --deny-warnings src tests",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "build:consumer": "pnpm build && vite build --config tests/consumer/vite.config.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": { "@webtools/parameters": "workspace:*" },
  "peerDependencies": { "react": "19.2.8", "react-dom": "19.2.8" },
  "devDependencies": { "react": "19.2.8", "react-dom": "19.2.8", "@types/react": "19.2.18", "@types/react-dom": "19.2.7", "@types/node": "26.6.4", "typescript": "7.0.2", "oxlint": "1.81.0", "vite": "8.3.0", "@vitejs/plugin-react": "6.1.1" }
}
