{
  "name": "@webtools/widget-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./assets/*": "./assets/*"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.consumer.json",
    "lint": "oxlint --deny-warnings src tests",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "build:consumer": "pnpm build && vite build --config tests/consumer/vite.config.ts",
    "test:browser": "node tests/browser.mjs"
  },
  "dependencies": {
    "@webtools/mavlink": "workspace:*",
    "gridstack": "10.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "flight-indicators-js": "1.0.5",
    "formiojs": "4.21.7",
    "leaflet": "1.9.4",
    "leaflet-rotatedmarker": "0.2.0",
    "oxlint": "1.81.0",
    "plotly.js-dist-min": "2.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
