{
  "name": "@webtools/dataflash",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.types.json",
    "lint": "biome lint --error-on-warnings .",
    "build": "tsc -p tsconfig.json && node build.mjs",
    "test": "pnpm typecheck && pnpm build && node --test tests/*.test.mjs",
    "test:browser": "pnpm build && node tests/browser.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
